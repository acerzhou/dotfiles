# Homebrew Bundle File
# Install with: make install PROFILE=default
# ═══════════════════════════════════════════════════════════

# Core formulae, casks, and Bundle are provided by Homebrew.

# ═══════════════════════════════════════════════════════════
# Command Line Tools
# ═══════════════════════════════════════════════════════════

# Shell & Terminal
brew "zsh"
brew "tmux"
brew "fzf"
brew "autojump"

# Version Control
brew "git"
brew "gh"  # GitHub CLI

# Development Tools
brew "vim"
brew "htop"
brew "tree"
brew "wget"
brew "curl"

# Text Processing
brew "jq"   # JSON processor
brew "yq"   # YAML processor
brew "bat"  # Better cat

# Search & Navigation
brew "ripgrep"  # Better grep
brew "fd"       # Better find

# Database Tools
brew "libpq"  # PostgreSQL CLI

# Version Managers
# brew "jenv"  # Java version manager

# Build Tools
# brew "cmake"
brew "shellcheck"  # Shell script linter

# File Compression
# brew "p7zip"
# brew "unrar"
